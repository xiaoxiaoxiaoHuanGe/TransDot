# Application
HOST_BIND=0.0.0.0
HOST_PORT=5757
DATA_DIR=/app/data

# Public HTTPS origin embedded in Android bootstrap/pairing QR payloads.
# Leave empty only for local development, where the request origin is used.
PUBLIC_URL=

# Docker Official Images mirror used only while building the image.
OFFICIAL_IMAGE_REGISTRY=public.ecr.aws/docker/library

# Go module proxy used only while building the image. Mainland China users can
# set this to https://goproxy.cn,direct without editing the Dockerfile.
GOPROXY=https://proxy.golang.org,direct

# Optional manual recovery key. QR bootstrap works while this is empty.
# If set, use at least 32 random characters and never commit the real value.
OWNER_SETUP_TOKEN=

# Upload limits (bytes)
MAX_FILE_BYTES=314572800
MAX_BATCH_BYTES=524288000
MAX_BATCH_ITEMS=20
FILE_POOL_MAX_BYTES=1073741824

# Lifetimes
FILE_TTL_HOURS=24
FILE_MESSAGE_TTL_DAYS=30
PAIRING_TTL_SECONDS=120
UPLOAD_SESSION_TTL_MINUTES=30
