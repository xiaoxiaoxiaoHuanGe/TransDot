# Application
PORT=5757
DATA_DIR=/app/data

# Docker Official Images mirror used only while building the image.
OFFICIAL_IMAGE_REGISTRY=public.ecr.aws/docker/library

# Set this to a strong random value before the setup flow is implemented.
# Never commit a real token.
OWNER_SETUP_TOKEN=replace-with-a-strong-random-token

# Upload limits (bytes)
MAX_FILE_BYTES=314572800
MAX_BATCH_BYTES=524288000
MAX_BATCH_ITEMS=20
FILE_POOL_MAX_BYTES=1073741824

# Lifetimes
FILE_TTL_HOURS=24
FILE_MESSAGE_TTL_DAYS=30
PAIRING_TTL_SECONDS=120
UPLOAD_SESSION_TTL_MINUTES=30
